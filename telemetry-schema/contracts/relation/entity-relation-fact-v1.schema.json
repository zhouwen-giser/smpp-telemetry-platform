{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smpp-telemetry:entity-relation:1.0.0",
  "type": "object",
  "required": [
    "relationId",
    "relationType",
    "sourceEntityUrn",
    "targetEntityUrn",
    "sourceSystem",
    "targetSystem",
    "confidenceClass"
  ],
  "properties": {
    "relationId": {
      "type": "string",
      "format": "uuid"
    },
    "relationType": {
      "enum": [
        "delegates_to",
        "invokes",
        "served_by",
        "executes_on",
        "routes_to",
        "retries_as",
        "correlates_with",
        "observes",
        "supersedes"
      ]
    },
    "sourceEntityUrn": {
      "type": "string",
      "pattern": "^urn:telemetry:"
    },
    "targetEntityUrn": {
      "type": "string",
      "pattern": "^urn:telemetry:"
    },
    "sourceSystem": {
      "type": "string"
    },
    "targetSystem": {
      "type": "string"
    },
    "confidenceClass": {
      "enum": [
        "authoritative",
        "configured",
        "traced",
        "derived"
      ]
    },
    "reconciliationProvenance": {
      "type": "object",
      "properties": {
        "producerSystem": { "const": "smpp" },
        "claimSource": { "const": "providerops.correlation" },
        "semanticClass": { "const": "source_declared_reconciliation_claim" },
        "authority": { "const": false },
        "maySelectFacts": { "const": false },
        "mayOverrideBinding": { "const": false },
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "sourceRecordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "factId": { "type": "string", "format": "uuid" },
        "policyId": { "const": "smpp.providerops-correlation-policy/v1.1" },
        "policyVersion": { "const": 1 }
      },
      "required": [
        "producerSystem",
        "claimSource",
        "semanticClass",
        "authority",
        "maySelectFacts",
        "mayOverrideBinding",
        "sourceRecordId",
        "sourceRecordHash",
        "factId",
        "policyId",
        "policyVersion"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
