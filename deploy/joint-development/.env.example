# Runtime bootstrap PMS_INSTANCE_ID；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__PMS_INSTANCE_ID=

# Runtime bootstrap RUNTIME_DEPLOYMENT_ID；规则 {"type":"string"}；默认 "joint-development"；重启生效。
RUNTIME__RUNTIME_DEPLOYMENT_ID="joint-development"

# Runtime bootstrap RUNTIME_INSTANCE_ID；规则 {"type":"string"}；默认 "smpp-joint-development-1"；重启生效。
RUNTIME__RUNTIME_INSTANCE_ID="smpp-joint-development-1"

# Runtime bootstrap SDAR_BUILD_REVISION；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__SDAR_BUILD_REVISION=

# PMS 心跳间隔，毫秒；单位毫秒；规则 {"type":"integer","minimum":1,"maximum":120000}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__PMS_RUNTIME_HEARTBEAT_INTERVAL_MS=

# 独立 Compose 项目名；更改会创建另一套卷；规则 {"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$"}；默认 "smpp-telemetry-development"；重启生效。
DEPLOY_PROJECT="smpp-telemetry-development"

# 宿主监听 IP；仅隔离开发网络，禁止公网；规则 {"type":"string"}；默认 "0.0.0.0"；重启生效。
DEPLOY_BIND_ADDRESS="0.0.0.0"

# 访问清单中的服务器 IP/DNS；部署服务器供他人访问时必须修改；规则 {"type":"string"}；默认 "localhost"；重启生效。
DEPLOY_PUBLIC_HOST="localhost"

# SMPP 阶段，不表示资格认证；规则 {"type":"string","enum":["development_debug","integration_candidate","qualification"]}；默认 "development_debug"；重启生效。
DEPLOY_STAGE="development_debug"

# 显式开发免凭证；false 时必须配置两侧原生鉴权与 Telemetry API keys；规则 {"type":"boolean"}；默认 "true"；重启生效。
DEPLOY_DEV_NO_AUTH="true"

# 服务与投影等待上限，秒；单位秒；规则 {"type":"integer","minimum":1,"maximum":3600}；默认 180；重启生效。
DEPLOY_WAIT_SECONDS="180"

# SMPP 双架构构建基础镜像；规则 {"type":"string"}；默认 "node:22-bookworm-slim"；重启生效。
NODE_BASE_IMAGE="node:22-bookworm-slim"

# 双架构 PostgreSQL 镜像；规则 {"type":"string"}；默认 "postgres:17-alpine"；重启生效。
POSTGRES_IMAGE="postgres:17-alpine"

# 双架构开发 ClickHouse；不替代 ARM64 release 源码构建门禁；规则 {"type":"string"}；默认 "clickhouse/clickhouse-server:25.3.14.14"；重启生效。
CLICKHOUSE_IMAGE="clickhouse/clickhouse-server:25.3.14.14"

# Collector 双架构镜像；规则 {"type":"string"}；默认 "otel/opentelemetry-collector-contrib:0.157.0"；重启生效。
COLLECTOR_IMAGE="otel/opentelemetry-collector-contrib:0.157.0"

# Grafana 双架构镜像；规则 {"type":"string"}；默认 "grafana/grafana:12.1.0"；重启生效。
GRAFANA_IMAGE="grafana/grafana:12.1.0"

# 精确可信 Collector ID；规则 {"type":"string"}；默认 "joint-development-collector"；重启生效。
COLLECTOR__COLLECTOR_ID="joint-development-collector"

# 精确信任域；规则 {"type":"string"}；默认 "joint-development"；重启生效。
COLLECTOR__TRUST_DOMAIN="joint-development"

# Runtime Prometheus HTTP 路径；规则 {"type":"string"}；默认 "/metrics"；重启生效。
COLLECTOR__SMPP_METRICS_PATH="/metrics"

# Prometheus 拉取周期，例如 15s；规则 {"type":"string"}；默认 "15s"；重启生效。
COLLECTOR__SMPP_METRICS_SCRAPE_INTERVAL="15s"

# 稳定精确 SMPP Source ID，不允许通配；规则 {"type":"string"}；默认 "smpp.joint-development.ugv1"；重启生效。
SOURCE_ID="smpp.joint-development.ugv1"

# Telemetry 数据租户；规则 {"type":"string"}；默认 "tenant-local"；重启生效。
TENANT_ID="tenant-local"

# Telemetry 数据项目；规则 {"type":"string"}；默认 "smpp-development"；重启生效。
PROJECT_ID="smpp-development"

# 必填：已有 SDAR ClickHouse HTTP(S) 地址；不得填入 URL 凭证；规则 {"type":"string","format":"uri"}；默认 不传入/自动派生（见说明）；重启生效。
# SHARED__URL=

# 已有共享库账号；需要 SELECT、两事实表 INSERT，脚本只读预检；规则 {"type":"string"}；默认 "telemetry_projection_writer"；重启生效。
SHARED__USER="telemetry_projection_writer"

# 已有共享库密码；建议使用 PASSWORD_FILE；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# SHARED__PASSWORD=

# 共享库密码文件，宿主路径，相对于 .env 目录；优先于明文；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# SHARED__PASSWORD_FILE=

# 独立 ClickHouse 用户；规则 {"type":"string"}；默认 "default"；重启生效。
CLICKHOUSE__USER="default"

# 独立库密码；省略则首次自动生成并持久保存；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# CLICKHOUSE__PASSWORD=

# 独立库密码宿主文件，优先于明文；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# CLICKHOUSE__PASSWORD_FILE=

# WAL 空间告警字节阈值；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 912680550；重启生效。
GRAFANA__ALERT_WAL_BYTES="912680550"

# 持久索引空间告警字节阈值；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 1073741824；重启生效。
GRAFANA__ALERT_STATE_BYTES="1073741824"

# 归档空间告警字节阈值；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 10737418240；重启生效。
GRAFANA__ALERT_ARCHIVE_BYTES="10737418240"

# DLQ 空间告警字节阈值；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 268435456；重启生效。
GRAFANA__ALERT_DLQ_BYTES="268435456"

# 最老未处置记录等待告警毫秒阈值；单位毫秒；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 300000；重启生效。
GRAFANA__ALERT_PENDING_AGE_MS="300000"

# Grafana 管理员；规则 {"type":"string"}；默认 "admin"；重启生效。
GRAFANA__ADMIN_USER="admin"

# 省略则首次生成并保存，不输出到控制台；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# GRAFANA__ADMIN_PASSWORD=

# Grafana 密码宿主文件，优先于明文；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# GRAFANA__ADMIN_PASSWORD_FILE=

# MCP 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 19100；重启生效。
PORT_MCP="19100"

# ADAPTER 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 17010；重启生效。
PORT_ADAPTER="17010"

# PROVIDER_TELEMETRY 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 17002；重启生效。
PORT_PROVIDER_TELEMETRY="17002"

# RUNTIME_DB 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 15432；重启生效。
PORT_RUNTIME_DB="15432"

# ADAPTER_DB 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 15433；重启生效。
PORT_ADAPTER_DB="15433"

# OTLP_GRPC 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 4317；重启生效。
PORT_OTLP_GRPC="4317"

# OTLP_HTTP 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 4318；重启生效。
PORT_OTLP_HTTP="4318"

# PROCESSOR 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 8443；重启生效。
PORT_PROCESSOR="8443"

# QUERY 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 8088；重启生效。
PORT_QUERY="8088"

# GRAFANA 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 3000；重启生效。
PORT_GRAFANA="3000"

# CLICKHOUSE_HTTP 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 8123；重启生效。
PORT_CLICKHOUSE_HTTP="8123"

# CLICKHOUSE_NATIVE 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 9000；重启生效。
PORT_CLICKHOUSE_NATIVE="9000"

# COLLECTOR_HEALTH 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 13133；重启生效。
PORT_COLLECTOR_HEALTH="13133"

# COLLECTOR_METRICS 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 8888；重启生效。
PORT_COLLECTOR_METRICS="8888"

# RUNTIME_METRICS 宿主端口，与容器内部端口区分；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 9464；重启生效。
PORT_RUNTIME_METRICS="9464"

# Processor 容器监听 IP；规则 {"type":"string"}；默认 "0.0.0.0"；重启生效。
PROCESSOR__PROCESSOR_HOST="0.0.0.0"

# Processor 容器端口；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 8443；重启生效。
PROCESSOR__PROCESSOR_PORT="8443"

# 入口请求最大解压后字节数；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 4194304；重启生效。
PROCESSOR__MAX_REQUEST_BYTES="4194304"

# 容器 WAL 路径；自动挂载持久卷；规则 {"type":"string"}；默认 "/var/lib/smpp-telemetry/wal"；重启生效。
PROCESSOR__WAL_DIR="/var/lib/smpp-telemetry/wal"

# WAL 单段字节数；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 67108864；重启生效。
PROCESSOR__WAL_SEGMENT_MAX_BYTES="67108864"

# WAL 总字节上限；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 10737418240；重启生效。
PROCESSOR__WAL_MAX_BYTES="10737418240"

# 最大待写入数；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 1024；重启生效。
PROCESSOR__WAL_MAX_PENDING_WRITES="1024"

# WAL 文件系统停收预留字节数；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 67108864；重启生效。
PROCESSOR__WAL_MIN_FREE_BYTES="67108864"

# WAL 内存缓存字节上限；单位字节；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 8388608；重启生效。
PROCESSOR__WAL_CACHE_MAX_BYTES="8388608"

# WAL 归档目录；部署时使用 WAL 持久卷内路径；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__WAL_ARCHIVE_DIR=

# 启用满足确认门禁的 WAL 归档及回收；规则 {"type":"boolean"}；默认 "false"；重启生效。
PROCESSOR__WAL_GC_ENABLED="false"

# WAL 维护周期，毫秒；单位毫秒；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 60000；重启生效。
PROCESSOR__WAL_MAINTENANCE_INTERVAL_MS="60000"

# 独立重放目标注册配置文件；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__REPLAY_TARGETS_FILE=

# WAL 拒绝阈值比例 (0,1]；规则 {"type":"number","minimum":0.01,"maximum":1}；默认 0.98；重启生效。
PROCESSOR__WAL_REJECT_THRESHOLD="0.98"

# 每批投影条数；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 200；重启生效。
PROCESSOR__EXPORT_BATCH_SIZE="200"

# 投影轮询毫秒；单位毫秒；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 1000；重启生效。
PROCESSOR__EXPORT_INTERVAL_MS="1000"

# 关闭等待毫秒；单位毫秒；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 10000；重启生效。
PROCESSOR__PROCESSOR_SHUTDOWN_TIMEOUT_MS="10000"

# 高级覆盖：完整映射 JSON，宿主文件；省略自动生成；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__SOURCE_MAPPINGS_FILE=

# 高级覆盖：完整 target JSON，宿主文件；省略自动生成；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__PROJECTION_TARGETS_FILE=

# 保留精确 Collector 身份校验；规则 {"type":"boolean"}；默认 "true"；重启生效。
PROCESSOR__PROCESSOR_REQUIRE_COLLECTOR_ID="true"

# 允许的 Collector ID，逗号分隔；省略使用 COLLECTOR__COLLECTOR_ID；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__PROCESSOR_ALLOWED_COLLECTOR_IDS=

# 非免凭证模式管理 API key；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__PROCESSOR_ADMIN_API_KEY=

# 管理 key 宿主文件，优先于明文；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__PROCESSOR_ADMIN_API_KEY_FILE=

# 开发默认明文；required 时需配置证书以及自定义 Collector 配置；规则 {"type":"string","enum":["disabled","required"]}；默认 "disabled"；重启生效。
PROCESSOR__PROCESSOR_TLS_MODE="disabled"

# TLS PEM 宿主文件；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__PROCESSOR_TLS_CA_FILE=

# TLS PEM 宿主文件；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__PROCESSOR_TLS_CERT_FILE=

# TLS PEM 宿主文件；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# PROCESSOR__PROCESSOR_TLS_KEY_FILE=

# 启用共享权威查询；就绪检查要求共享库可读；规则 {"type":"boolean"}；默认 true；重启生效。
QUERY__AUTHORITY_ENABLED="true"

# 固定权威范围 JSON：tenantId/projectId/environment/smppSourceId/deploymentId；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__AUTHORITY_DEFAULT_SCOPE_JSON=

# 每个查询存储就绪探测超时毫秒；单位毫秒；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 2000；重启生效。
QUERY__QUERY_READINESS_TIMEOUT_MS="2000"

# 查询就绪缓存毫秒；单位毫秒；规则 {"type":"integer","minimum":1,"maximum":9007199254740991}；默认 1000；重启生效。
QUERY__QUERY_READINESS_CACHE_MS="1000"

# 启用013查询快照；必须与Target snapshotEnabled同时开启；规则 {"type":"boolean"}；默认 false；重启生效。
QUERY__QUERY_SNAPSHOTS_ENABLED="false"

# 查询快照目标身份；规则 {"type":"string"}；默认 "standalone-smpp"；重启生效。
QUERY__QUERY_SNAPSHOT_TARGET_ID="standalone-smpp"

# 至少32字节的游标签名密钥；未指定由联合部署生成并持久保存；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__QUERY_CURSOR_KEY=

# 游标签名密钥文件；优先于明文；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__QUERY_CURSOR_KEY_FILE=

# 离线切代 reader 注册文件，按实际宿主路径只读挂载；规则 {"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__QUERY_READER_REGISTRY_FILE=

# Query 容器监听地址；规则 {"type":"string"}；默认 "0.0.0.0"；重启生效。
QUERY__QUERY_API_HOST="0.0.0.0"

# Query 容器端口；规则 {"type":"integer","minimum":1,"maximum":65535}；默认 8088；重启生效。
QUERY__QUERY_API_PORT="8088"

# 非免凭证模式查询 key；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__QUERY_API_KEY=

# 查询 key 宿主文件；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__QUERY_API_KEY_FILE=

# 高级查询连接覆盖；默认继承独立库；FILE 为宿主路径；规则 {"type":"string","writeOnly":false}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__CLICKHOUSE_URL=

# 高级查询连接覆盖；默认继承独立库；FILE 为宿主路径；规则 {"type":"string","writeOnly":false}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__CLICKHOUSE_USER=

# 高级查询连接覆盖；默认继承独立库；FILE 为宿主路径；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__CLICKHOUSE_PASSWORD=

# 高级查询连接覆盖；默认继承独立库；FILE 为宿主路径；规则 {"type":"string","writeOnly":true}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__CLICKHOUSE_PASSWORD_FILE=

# 高级查询连接覆盖；默认继承共享库；FILE 为宿主路径；规则 {"type":"string","writeOnly":false}；默认 不传入/自动派生（见说明）；重启生效。
# QUERY__AUTHORITY_CLICKHOUSE_URL=

