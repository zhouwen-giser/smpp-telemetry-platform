# SMPP + Telemetry 联合开发环境；仅隔离纯软件仿真网络。
# Node >=22，Linux amd64/arm64；修改后执行 up 重建容器。
# 唯一输入本文件，不 source shell，不继承宿主同名变量。FILE 参数为宿主路径。
# 可选项保持注释；SHARED__URL 和 SHARED__PASSWORD[_FILE] 必须填写。

# RUNTIME ADAPTER_ENDPOINT（runtime.bootstrap）；规则 {"type":"string"}；默认 "adapter:7010"；重启生效。
RUNTIME__ADAPTER_ENDPOINT="adapter:7010"

# RUNTIME ADAPTER_RPC_TIMEOUT_MS（runtime.bootstrap）；单位毫秒；规则 {"maximum":60000,"minimum":1,"type":"integer"}；默认 "5000"；重启生效。
RUNTIME__ADAPTER_RPC_TIMEOUT_MS="5000"

# RUNTIME ADAPTER_TLS_CA_PATH（runtime.bootstrap）；规则 {"minLength":1,"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__ADAPTER_TLS_CA_PATH=

# RUNTIME ADAPTER_TLS_CERT_PATH（runtime.bootstrap）；规则 {"minLength":1,"type":"string"}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__ADAPTER_TLS_CERT_PATH=

# RUNTIME ADAPTER_TLS_KEY_PATH（runtime.bootstrap）；规则 {"minLength":1,"type":"string","writeOnly":true,"x-sdar-secretRef":true}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__ADAPTER_TLS_KEY_PATH=

# RUNTIME ADAPTER_TLS_MODE（runtime.bootstrap）；规则 {"enum":["disabled","required"]}；默认 "disabled"；重启生效。
RUNTIME__ADAPTER_TLS_MODE="disabled"

# RUNTIME ALLOW_INSECURE_INTERNAL_TRANSPORT（runtime.bootstrap）；规则 {"type":"boolean"}；默认 "false"；重启生效。
RUNTIME__ALLOW_INSECURE_INTERNAL_TRANSPORT="false"

# RUNTIME DATABASE_POOL_MAX（runtime.bootstrap）；规则 {"maximum":100,"minimum":1,"type":"integer"}；默认 "10"；重启生效。
RUNTIME__DATABASE_POOL_MAX="10"

# RUNTIME DATABASE_URL（runtime.bootstrap）；规则 {"format":"uri","type":"string","writeOnly":true,"x-sdar-secretRef":true}；默认 "postgresql://ugv_runtime:development-runtime@runtime-db:5432/ugv_runtime"；重启生效。
RUNTIME__DATABASE_URL="postgresql://ugv_runtime:development-runtime@runtime-db:5432/ugv_runtime"

# RUNTIME DATABASE_URL_FILE（runtime.bootstrap）；规则 {"minLength":1,"type":"string","writeOnly":true,"x-sdar-secretRef":true}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__DATABASE_URL_FILE=

# RUNTIME HOST（runtime.bootstrap）；规则 {"type":"string"}；默认 "0.0.0.0"；重启生效。
RUNTIME__HOST="0.0.0.0"

# RUNTIME PORT（runtime.bootstrap）；规则 {"maximum":65535,"minimum":1,"type":"integer"}；默认 "8080"；重启生效。
RUNTIME__PORT="8080"

# RUNTIME PROVIDER_ID（runtime.bootstrap）；规则 {"maxLength":128,"minLength":1,"type":"string"}；默认 "isr.vehicle.ugv.ugv1"；重启生效。
RUNTIME__PROVIDER_ID="isr.vehicle.ugv.ugv1"

# RUNTIME RUNTIME_ENV（runtime.bootstrap）；规则 {"enum":["development","test","production"]}；默认 "development"；重启生效。
RUNTIME__RUNTIME_ENV="development"

# RUNTIME LOG_LEVEL（runtime.observability）；规则 {"type":"string"}；默认 "info"；重启生效。
RUNTIME__LOG_LEVEL="info"

# RUNTIME OTEL_ENABLED（runtime.observability）；规则 {"type":"boolean"}；默认 "true"；重启生效。
RUNTIME__OTEL_ENABLED="true"

# RUNTIME OTEL_EXPORTER_OTLP_CA_PATH（runtime.observability）；规则 {"minLength":1,"type":"string","writeOnly":true,"x-sdar-secretRef":true}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__OTEL_EXPORTER_OTLP_CA_PATH=

# RUNTIME OTEL_EXPORTER_OTLP_CERT_PATH（runtime.observability）；规则 {"minLength":1,"type":"string","writeOnly":true,"x-sdar-secretRef":true}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__OTEL_EXPORTER_OTLP_CERT_PATH=

# RUNTIME OTEL_EXPORTER_OTLP_ENDPOINT（runtime.observability）；规则 {"format":"uri","type":"string"}；默认 "http://otel-collector:4318"；重启生效。
RUNTIME__OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4318"

# RUNTIME OTEL_EXPORTER_OTLP_HEADERS_FILE（runtime.observability）；规则 {"minLength":1,"type":"string","writeOnly":true,"x-sdar-secretRef":true}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__OTEL_EXPORTER_OTLP_HEADERS_FILE=

# RUNTIME OTEL_EXPORTER_OTLP_KEY_PATH（runtime.observability）；规则 {"minLength":1,"type":"string","writeOnly":true,"x-sdar-secretRef":true}；默认 不传入/自动派生（见说明）；重启生效。
# RUNTIME__OTEL_EXPORTER_OTLP_KEY_PATH=

# RUNTIME OTEL_EXPORTER_OTLP_TIMEOUT_MS（runtime.observability）；单位毫秒；规则 {"maximum":60000,"minimum":100,"type":"integer"}；默认 "10000"；重启生效。
RUNTIME__OTEL_EXPORTER_OTLP_TIMEOUT_MS="10000"

# RUNTIME OTEL_EXPORTER_OTLP_TLS_MODE（runtime.observability）；规则 {"enum":["disabled","required"]}；默认 "disabled"；重启生效。
RUNTIME__OTEL_EXPORTER_OTLP_TLS_MODE="disabled"

# RUNTIME OTEL_SERVICE_INSTANCE_ID（runtime.observability）；规则 {"maxLength":256,"minLength":1,"type":"string"}；默认 "smpp-joint-development-1"；重启生效。
RUNTIME__OTEL_SERVICE_INSTANCE_ID="smpp-joint-development-1"

# RUNTIME ADAPTER_HEALTH_FAILURE_THRESHOLD（runtime.workerEvents）；规则 {"default":2,"maximum":10,"minimum":1,"type":"integer"}；默认 "2"；重启生效。
RUNTIME__ADAPTER_HEALTH_FAILURE_THRESHOLD="2"

# RUNTIME ADAPTER_HEALTH_POLL_MS（runtime.workerEvents）；单位毫秒；规则 {"default":5000,"maximum":300000,"minimum":100,"type":"integer"}；默认 "5000"；重启生效。
RUNTIME__ADAPTER_HEALTH_POLL_MS="5000"

# RUNTIME ADAPTER_MANIFEST_POLL_MS（runtime.workerEvents）；单位毫秒；规则 {"default":60000,"maximum":3600000,"minimum":100,"type":"integer"}；默认 "60000"；重启生效。
RUNTIME__ADAPTER_MANIFEST_POLL_MS="60000"

# RUNTIME ALLOW_WEAK_LEASE_CONFIGURATION（runtime.workerEvents）；规则 {"type":"boolean"}；默认 "false"；重启生效。
RUNTIME__ALLOW_WEAK_LEASE_CONFIGURATION="false"

# RUNTIME ARGUMENT_MAX_BYTES（runtime.workerEvents）；单位字节；规则 {"default":1048576,"maximum":8388608,"minimum":256,"type":"integer"}；默认 "1048576"；重启生效。
RUNTIME__ARGUMENT_MAX_BYTES="1048576"

# RUNTIME ARGUMENT_MAX_DEPTH（runtime.workerEvents）；规则 {"default":32,"maximum":64,"minimum":1,"type":"integer"}；默认 "32"；重启生效。
RUNTIME__ARGUMENT_MAX_DEPTH="32"

# RUNTIME ARGUMENT_MAX_NODES（runtime.workerEvents）；规则 {"default":10000,"maximum":100000,"minimum":16,"type":"integer"}；默认 "10000"；重启生效。
RUNTIME__ARGUMENT_MAX_NODES="10000"

# RUNTIME AUTH_MODE（runtime.workerEvents）；规则 {"default":"development","enum":["development","anonymous","trusted_headers","jwt_hs256"],"type":"string"}；默认 "development"；重启生效。
RUNTIME__AUTH_MODE="development"

# RUNTIME BUSINESS_EVENT_CLOCK_SKEW_SAFETY_MS（runtime.workerEvents）；单位毫秒；规则 {"default":300000,"maximum":3600000,"minimum":0,"type":"integer"}；默认 "300000"；重启生效。
RUNTIME__BUSINESS_EVENT_CLOCK_SKEW_SAFETY_MS="300000"

# RUNTIME BUSINESS_EVENT_MAPPING_DEADLINE_MS（runtime.workerEvents）；单位毫秒；规则 {"default":60000,"maximum":300000,"minimum":1000,"type":"integer"}；默认 "60000"；重启生效。
RUNTIME__BUSINESS_EVENT_MAPPING_DEADLINE_MS="60000"

# RUNTIME BUSINESS_EVENT_MAX_FUTURE_SKEW_MS（runtime.workerEvents）；单位毫秒；规则 {"default":300000,"maximum":3600000,"minimum":0,"type":"integer"}；默认 "300000"；重启生效。
RUNTIME__BUSINESS_EVENT_MAX_FUTURE_SKEW_MS="300000"

# RUNTIME BUSINESS_EVENTS_ENABLED（runtime.workerEvents）；规则 {"type":"boolean"}；默认 "true"；重启生效。
RUNTIME__BUSINESS_EVENTS_ENABLED="true"

