COMPOSE_PROJECT_NAME=smpp-telemetry-goal01-qualification
TELEMETRY_TRANSPORT_MODE=qualification
TELEMETRY_PUBLIC_HOST=192.168.1.20
TELEMETRY_BIND_ADDRESS=192.168.1.20
TELEMETRY_IMAGE_REVISION=REPLACE_WITH_GOAL_HEAD_SHA
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
QUERY_API_PORT=8088
SMPP_DEPLOYMENT_ID=production-ugv-direct
COLLECTOR_ID=smpp-gateway-ugv-1
TRUST_DOMAIN=sdar-ugv-runtime-mtls
SMPP_PROVIDER_ID=isr.vehicle.ugv.ugv1
SMPP_RUNTIME_INSTANCE_ID=production-ugv-direct-1
SMPP_SERVICES='sdar-ugv-runtime|http://192.168.1.7:19100'
SMPP_METRICS_TARGET=192.168.1.7:19100
SMPP_METRICS_PATH=/metrics
SMPP_METRICS_SCRAPE_INTERVAL=15s
TELEMETRY_TENANT_ID=tenant-local
TELEMETRY_PROJECT_ID=smpp-local
TELEMETRY_ENVIRONMENT=qualification
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_SECRET
QUALIFICATION_SECRET_DIR=/absolute/path/to/qualification/secrets
TELEMETRY_SECRET_UID=1000
TELEMETRY_SECRET_GID=1000
ALLOW_SMPP_TELEMETRY_SIDE_EFFECT_TESTS=false
