# SMPP Telemetry Platform 一键部署配置
COMPOSE_PROJECT_NAME=smpp-telemetry

# 对外访问地址。SMPP Runtime 需要把 OTLP 数据推送到此地址。
TELEMETRY_PUBLIC_HOST=127.0.0.1
TELEMETRY_BIND_ADDRESS=127.0.0.1
OTLP_GRPC_PORT=4317
# 按部署要求，OTLP/HTTP 单独监听所有 IPv4 网卡；其他端口仍使用 TELEMETRY_BIND_ADDRESS。
OTLP_HTTP_BIND_ADDRESS=0.0.0.0
OTLP_HTTP_PORT=4318
QUERY_API_PORT=8088
GRAFANA_PORT=3000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ClickHouse 会在本机从固定源码提交编译。内存不足时设为 1；推荐值为 2。
CLICKHOUSE_BUILD_JOBS=2

# 部署标识，会写入可信入口属性
SMPP_DEPLOYMENT_ID=development
COLLECTOR_ID=smpp-gateway-1
TRUST_DOMAIN=local-compose
SMPP_PROVIDER_ID=isr.vehicle.ugv.ugv1
SMPP_RUNTIME_INSTANCE_ID=production-ugv-direct-1

# 采集的 SMPP 实例清单。格式：名称|服务地址，多个实例用逗号分隔。
# 注意：OpenTelemetry 是 SMPP 主动推送模型，此地址用于登记、生成接入配置和运维识别，Collector 不会主动轮询该地址。
SMPP_SERVICES='sdar-ugv-runtime|http://192.168.1.7:19100'

# Runtime Prometheus 拉取端点（host:port，不含 scheme/path）
SMPP_METRICS_TARGET=192.168.1.7:19100
SMPP_METRICS_PATH=/metrics
SMPP_METRICS_SCRAPE_INTERVAL=15s

# 默认数据归属
TELEMETRY_TENANT_ID=tenant-local
TELEMETRY_PROJECT_ID=smpp-local
TELEMETRY_ENVIRONMENT=development

# Grafana 管理员账号
GRAFANA_ADMIN_USER=admin
# 留空时 deploy.sh 会自动生成并写入 .env
GRAFANA_ADMIN_PASSWORD=

# 开发模式使用明文 OTLP；qualification 配置会覆盖为双向 TLS。
TELEMETRY_TRANSPORT_MODE=development
TELEMETRY_IMAGE_REVISION=development
